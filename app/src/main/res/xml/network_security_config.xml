<?xml version="1.0" encoding="utf-8"?>
<!-- Everything uses HTTPS except one thing: while an offline satellite area downloads, the app serves the map style to the
     map engine from the phone itself on the loopback address. Plain HTTP is allowed for that address only. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
